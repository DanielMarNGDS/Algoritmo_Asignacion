# ── Secretos ────────────────────────────────────────────────────────────────
.env
.env.*
# Un Secret de Kubernetes exportado con --dry-run=client -o yaml lleva el token o las cédulas en base64
*secret*.yaml
*secret*.yml

# ── Datos personales (cédulas, nombres): no van al repo ─────────────────────
data/*/nomina.json
data/contratos/propietarios.json
# El Excel de Ana, el PDF de propietarios o cualquier export que se deje en la carpeta para importar
*.xlsx
*.xls
*.csv
*.pdf
# El log de decisiones bajado del clúster (kubectl cp ... ./decisiones.jsonl) y cualquier otro log
*.jsonl
*.log

# ── Lo que genera el script y los interruptores ─────────────────────────────
logs/
data/PAUSA
data/*/PAUSA

# ── Dependencias ────────────────────────────────────────────────────────────
node_modules/

# ── Informes que no son de este paquete ─────────────────────────────────────
hallazgos_hubspot_mongo.html

# ── Sistema operativo, OneDrive, Office y editores ──────────────────────────
.DS_Store
Thumbs.db
desktop.ini
~$*
.vscode/
.idea/
.claude/settings.local.json
